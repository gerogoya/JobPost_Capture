{
  "manifest_version": 3,
  "name": "JobPost Capture",
  "description": "Manually capture and save job post data for career and market research.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPost Capture"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
